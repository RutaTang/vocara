<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The shipping app is fully sandboxed (the in-process engine needs no
	     external processes, unlike the DEBUG Python sidecar). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Microphone: live monitoring, recording takes, and analysis input. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Outbound HTTP: the in-app update check. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Open panels: importing songs/media the user picks. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Save panels: exporting mixes/recordings to a user-chosen location. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
